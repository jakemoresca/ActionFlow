<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ActionFlow.Api</RootNamespace>
    <UserSecretsId>actionflow-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Override the transitive 2.0.0 flagged by NU1903 (GHSA-v5pm-xwqc-g5wc); stays within v2. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="WolverineFx" Version="6.16.0" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Kafka" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActionFlow\ActionFlow.csproj" />
    <ProjectReference Include="..\ActionFlow.Contracts\ActionFlow.Contracts.csproj" />
    <ProjectReference Include="..\ActionFlow.DB\ActionFlow.DB.csproj" />
    <ProjectReference Include="..\ActionFlow.ServiceDefaults\ActionFlow.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
