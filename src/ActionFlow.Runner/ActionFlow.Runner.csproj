<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ActionFlow.Runner</RootNamespace>
    <UserSecretsId>actionflow-runner</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="WolverineFx" Version="6.16.0" />
    <!-- Wolverine 6 moved the Roslyn runtime compiler out of core; required for dynamic handler codegen. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Kafka" Version="6.16.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.16.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActionFlow\ActionFlow.csproj" />
    <ProjectReference Include="..\ActionFlow.Contracts\ActionFlow.Contracts.csproj" />
    <ProjectReference Include="..\ActionFlow.DB\ActionFlow.DB.csproj" />
    <ProjectReference Include="..\ActionFlow.ServiceDefaults\ActionFlow.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
